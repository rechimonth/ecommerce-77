rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDocument() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isAdmin() {
      return signedIn()
        && exists(userDocument())
        && get(userDocument()).data.role == 'admin';
    }
    function validProduct() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.nameLower is string
        && request.resource.data.image is string
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.categoryId in ['clothing', 'shoes', 'accessories'];
    }
    function validOrderStatus(status) {
      return status in ['pending', 'processing', 'completed', 'cancelled'];
    }

    // El usuario solo puede crear su propio perfil como customer. Admin se asigna
    // desde un entorno confiable (Firebase Console), nunca desde el formulario público.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Catálogo público de lectura. Todas las escrituras requieren rol verificado en Firestore.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    // Cada cliente ve solo sus órdenes; solo administración modifica estados.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.customerName is string
        && request.resource.data.email is string
        && request.resource.data.shippingAddress is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && validOrderStatus(request.resource.data.status);
      allow delete: if isAdmin();
    }

    // Cualquier otra colección queda denegada por defecto.
  }
}
